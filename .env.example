# Copie para .env e preencha:  cp .env.example .env

NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000

# Mesmo usuário/senha/banco do docker-compose.yml
DATABASE_URL=postgresql://financeiro:financeiro@localhost:5432/financeiro?schema=public

# Canais: configure o Telegram, o WhatsApp ou os dois (pelo menos um).

# Telegram: token entregue pelo @BotFather ao criar o bot
TELEGRAM_BOT_TOKEN=
# Seu user ID numérico no Telegram. Mensagens de qualquer outra pessoa são ignoradas.
ALLOWED_TELEGRAM_USER_ID=

# WhatsApp (opcional; veja "WhatsApp" no README). Preencha todos ou nenhum.
# No Brasil, precisa de um número +55 (o número de teste da Meta é bloqueado para o Brasil).
# "false" pausa o WhatsApp sem apagar as chaves abaixo.
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Uma senha qualquer que você inventa (mínimo 8 caracteres) e repete no painel da Meta.
WHATSAPP_VERIFY_TOKEN=
# Seu número com DDI e DDD, só dígitos (ex.: 5511999998888).
ALLOWED_WHATSAPP_NUMBER=
# Modelo aprovado na Meta para os avisos com a janela de 24h fechada.
WHATSAPP_NOTICE_TEMPLATE=avisos_pendentes
# Limite grátis da Meta por mês e quando avisar para usar o Telegram.
WHATSAPP_FREE_MONTHLY_MESSAGES=1000
WHATSAPP_USAGE_WARNING_AT=900
# Túnel público do webhook (conta grátis em ngrok.com).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Chave criada no Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tentados em ordem quando o principal está sobrecarregado ou sem cota. Na camada gratuita,
# cada modelo tem cota diária própria (~20 mensagens), então mais modelos = mais mensagens.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

APP_TIMEZONE=America/Sao_Paulo

# Planilha Google (opcional; veja "Planilha Google" no README).
# Cole o link da planilha ou só o ID. Deixe vazio para não usar planilha.
GOOGLE_SHEETS_ID=
# Onde está a chave da conta de serviço (o padrão já funciona; no Docker é ajustado sozinho).
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
