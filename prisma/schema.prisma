// Prisma ORM 7: o client é gerado como código TypeScript dentro de src/ (não mais em
// node_modules) e a URL do banco fica em prisma.config.ts, não aqui.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Explícitos para não depender de o Prisma inferir pelo tsconfig.json (que não
  // existe no momento do `prisma generate` dentro do Docker). Sem isso, os imports
  // saíam como "./enums.ts" e o JavaScript compilado quebrava em produção.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  EXPENSE
  INCOME
}

// Um único enum para despesas e receitas mantém a tabela simples. A regra
// "categoria de receita só com type INCOME" é validada na aplicação (Zod).
enum Category {
  // Despesas
  ALIMENTACAO
  MERCADO
  TRANSPORTE
  MORADIA
  CONTAS
  SAUDE
  EDUCACAO
  LAZER
  ASSINATURAS
  COMPRAS
  OUTROS
  // Receitas
  SALARIO
  ESTAGIO
  FREELA
  OUTROS_RECEITA
  VALE_REFEICAO
  VALE_ALIMENTACAO
}

enum PaymentMethod {
  PIX
  CREDITO
  DEBITO
  DINHEIRO
  VR
  VA
  OUTRO
}

enum InputSource {
  TEXT
  AUDIO
}

model Transaction {
  // UUIDv7 é ordenado por tempo: índice mais compacto e ordem natural de criação.
  id            String          @id @default(uuid(7)) @db.Uuid
  type          TransactionType
  // Sempre em centavos. Int (32 bits) comporta até R$ 21.474.836,47 por lançamento.
  amountCents   Int
  description   String
  category      Category
  paymentMethod PaymentMethod?
  // Só a data (sem hora): evita que um fuso mal aplicado mude o dia do gasto.
  occurredAt    DateTime        @db.Date
  // Texto original ou transcrição do áudio, para auditoria.
  rawInput      String
  source        InputSource
  // Agrupa as transações criadas pela mesma mensagem ("almoço 32 e uber 18").
  // É o que o botão "Desfazer" referencia no callback_data (limite de 64 bytes).
  batchId       String          @db.Uuid
  // Cartão ou conta de onde saiu (ou para onde entrou) o dinheiro. Opcional: dinheiro
  // vivo não tem conta, e lançamentos antigos não tinham esse campo.
  accountId     Int?
  account       Account?        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  // Compra parcelada ("300 em 3x"): amountCents é o total; as parcelas são calculadas.
  installments  Int             @default(1)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)

  @@index([accountId])
  @@index([batchId])
  @@index([createdAt])
  @@index([occurredAt])
  @@map("transactions")
}

enum AccountKind {
  BANK // conta bancária: débito e pix
  CREDIT_CARD
  MEAL_VOUCHER // VR
  FOOD_VOUCHER // VA
}

/// Cartões e contas do usuário ("Itaú", "Santander", "VA").
/// "Itaú com conta e crédito" vira duas linhas com o mesmo nome, uma de cada tipo.
model Account {
  // Inteiro (e não UUID) de propósito: vai no callback_data dos botões do Telegram,
  // que tem limite de 64 bytes, junto com o id da pendência.
  id                    Int              @id @default(autoincrement())
  name                  String
  kind                  AccountKind
  // VR/VA: saldo informado no cadastro (ou no "Ajustar saldo"). O saldo atual é sempre
  // calculado: inicial + receitas - despesas. Nunca é guardado pronto.
  initialBalanceCents   Int              @default(0)
  // Crédito: limite e dia de fechamento da fatura (opcionais: sem eles, o bot só
  // registra em qual cartão foi).
  creditLimitCents      Int?
  closingDay            Int?
  // Diferença informada pelo usuário ("Ajustar disponível") para o disponível calculado
  // bater com o do banco, que conhece compras de antes do cadastro.
  creditAdjustmentCents Int              @default(0)
  // Remover no menu arquiva, para não perder o histórico das transações.
  archivedAt            DateTime?        @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  transactions          Transaction[]
  invoicePayments       InvoicePayment[]

  @@map("accounts")
}

/// Lançamento interpretado pela IA esperando uma resposta (forma de pagamento ou cartão).
/// Só vira Transaction quando tudo estiver resolvido.
model PendingEntry {
  // Inteiro curto, pelo mesmo motivo do Account.id (callback_data).
  id         Int         @id @default(autoincrement())
  // Rascunhos da IA + escolhas já feitas nos botões. Revalidado com Zod ao ler.
  drafts     Json
  rawInput   String
  source     InputSource
  receivedAt DateTime    @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@map("pending_entries")
}

/// Estado de conversas de vários passos (ex.: cadastro de cartão), para o nome digitado
/// ir para o cadastro e não para a IA. Uma linha só: o bot tem um único usuário.
model ChatState {
  id        Int      @id @default(1)
  state     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("chat_state")
}

/// Fatura de cartão de crédito marcada como paga ("Paguei a fatura"): libera o limite
/// das compras daquela fatura.
model InvoicePayment {
  id           Int      @id @default(autoincrement())
  accountId    Int
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  // Mês em que a fatura fecha, "YYYY-MM".
  invoiceMonth String
  paidAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([accountId, invoiceMonth])
  @@map("invoice_payments")
}
